cabal-version: 3.0
name:          quandary
version:       0.1.0
synopsis:      Explore a design space
description:
  Questions, options and the constraints between them, written as Markdown
  files; rulings recorded in named points. Reports which options stay
  possible, which are forced, the rulings responsible, and what to decide
  next.
license:       MIT
license-file:  LICENSE
author:        Tony Du
category:      Development
build-type:    Simple
tested-with:   GHC == 9.10.3
extra-doc-files: README.md
extra-source-files:
  web/*.css
  web/*.js
  web/vendor/**/*.js
  test/fixtures/**/*.md
  test/golden/*.txt
  test/golden/*.html

common shared
  default-language:   GHC2024
  default-extensions:
    DuplicateRecordFields
    NoFieldSelectors
    OverloadedRecordDot
    LambdaCase
    OverloadedStrings
  ghc-options:      -Wall
  build-depends:    base

library
  import:          shared
  hs-source-dirs:  src
  autogen-modules: Paths_quandary
  other-modules:   Paths_quandary
  exposed-modules:
    Quandary.Core.Analyse
    Quandary.Core.GradeRamp
    Quandary.Core.Next
    Quandary.Core.Compile
    Quandary.Core.Order
    Quandary.Core.Rulings
    Quandary.Core.Solver
    Quandary.Core.Source
    Quandary.Core.Types
    Quandary.Core.Validate
    Quandary.Core.View
    Quandary.Shell.Assets
    Quandary.Shell.Browse
    Quandary.Shell.Cli
    Quandary.Shell.Command.Accept
    Quandary.Shell.Command.Adopt
    Quandary.Shell.Command.Browse
    Quandary.Shell.Command.Check
    Quandary.Shell.Command.Defeat
    Quandary.Shell.Command.Defer
    Quandary.Shell.Command.Diff
    Quandary.Shell.Command.Exhaust
    Quandary.Shell.Command.Graph
    Quandary.Shell.Command.Init
    Quandary.Shell.Command.Next
    Quandary.Shell.Command.Links
    Quandary.Shell.Command.Point
    Quandary.Shell.Command.Prefer
    Quandary.Shell.Command.Reopen
    Quandary.Shell.Command.Rulings
    Quandary.Shell.Command.Serve
    Quandary.Shell.Command.Settle
    Quandary.Shell.Command.Show
    Quandary.Shell.Command.Status
    Quandary.Shell.Command.Whatif
    Quandary.Shell.Command.Why
    Quandary.Shell.Env
    Quandary.Shell.Exit
    Quandary.Shell.Fuzzy
    Quandary.Shell.Markdown
    Quandary.Shell.Options
    Quandary.Shell.Render.Cytoscape
    Quandary.Shell.Render.Dot
    Quandary.Shell.Render.Graph
    Quandary.Shell.Render.Html
    Quandary.Shell.Render.Markdown
    Quandary.Shell.Render.Mermaid
    Quandary.Shell.Render.Text
    Quandary.Shell.Render.Tui
    Quandary.Shell.Resolve
    Quandary.Shell.Rule
    Quandary.Shell.Search
    Quandary.Shell.Serve
    Quandary.Shell.Solver.Cadical
    Quandary.Shell.Storage.Files
    Quandary.Shell.Storage.Yaml
  build-depends:
    , aeson
    , async
    , brick
    , bytestring
    , commonmark
    , commonmark-extensions
    , conduit
    , containers
    , directory
    , file-embed
    , filepath
    , fsnotify
    , http-types
    , libyaml
    , lucid2
    , microlens
    , optparse-applicative
    , stm
    , text
    , time
    , vty
    , wai
    , warp
  pkgconfig-depends: cadical
  extra-libraries:   stdc++

executable quandary
  import:         shared
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:  quandary

test-suite spec
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -threaded
  build-tool-depends: quandary:quandary
  other-modules:
    BruteForce
    Cli
    Commands
    Examples
    Fixtures
    Frontends
    Gen
    Properties
    Solvers
    Storage
    Toysolver
  build-depends:
    , async
    , bytestring
    , containers
    , directory
    , filepath
    , http-types
    , lucid2
    , process
    , quandary
    , QuickCheck
    , tasty
    , tasty-golden
    , tasty-hunit
    , tasty-quickcheck
    , temporary
    , text
    , time
    , toysolver
    , wai
